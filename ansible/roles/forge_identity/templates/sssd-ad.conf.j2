# Managed by Forge-OS (forge_identity, backend=ad)
[sssd]
domains = {{ forge_ad_domain }}
config_file_version = 2
services = nss, pam

[domain/{{ forge_ad_domain }}]
id_provider = ad
access_provider = ad
ad_domain = {{ forge_ad_domain }}
krb5_realm = {{ forge_ad_domain | upper }}
cache_credentials = True
krb5_store_password_if_offline = True
default_shell = /bin/bash
fallback_homedir = /home/%u@%d
use_fully_qualified_names = False
ldap_id_mapping = True
ad_gpo_access_control = enforcing
dyndns_update = False
