# Copy to .env and `set -a; source .env; set +a` before `make iso`.
# Never commit .env (it is git-ignored).
FORGE_ADMIN_SSH_KEY="ssh-ed25519 AAAA... you@example.com"
# Optional: the build-time LUKS passphrase (random if unset; rotated at first boot)
#FORGE_LUKS_PASSPHRASE=
# Optional: node defaults baked into the ISO
FORGE_HOSTNAME=forge-node
FORGE_ADMIN_USER=forge
FORGE_TIMEZONE=Europe/Rome
# Optional: TPM / escrow / compliance knobs (see overlay/etc/forge.conf.tmpl)
FORGE_TPM_ENROLL=auto
FORGE_TPM_PCRS=7
#FORGE_TANG_URLS=http://tang-1.example.com:8080,http://tang-2.example.com:8080
FORGE_CIS_LEVEL=1
FORGE_IDENTITY_BACKEND=none
# Optional: serial console for headless/KVM testing
#FORGE_KERNEL_ARGS="console=ttyS0,115200n8 console=tty0"
PROFILE=baseline
