# Forge-OS ${FORGE_VERSION} boot menu (profile: ${PROFILE})
# Rendered by build/scripts/40-patch-grub.sh. The first entry runs a fully
# unattended installation and DESTROYS the target disk.
set timeout=${GRUB_TIMEOUT}
set default=0

loadfont unicode
set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

menuentry "Forge-OS ${FORGE_VERSION} - Automated install (${PROFILE}) [ERASES TARGET DISK]" {
	set gfxpayload=keep
	linux	/casper/vmlinuz autoinstall ds=nocloud\;s=/cdrom/forge/autoinstall/ ${FORGE_KERNEL_ARGS} ---
	initrd	/casper/initrd
}
menuentry "Forge-OS ${FORGE_VERSION} - Install with confirmation prompt" {
	set gfxpayload=keep
	linux	/casper/vmlinuz ds=nocloud\;s=/cdrom/forge/autoinstall/ ${FORGE_KERNEL_ARGS} ---
	initrd	/casper/initrd
}
menuentry "Forge-OS ${FORGE_VERSION} - Automated install (serial console ttyS0)" {
	set gfxpayload=keep
	linux	/casper/vmlinuz autoinstall ds=nocloud\;s=/cdrom/forge/autoinstall/ console=ttyS0,115200n8 console=tty0 ${FORGE_KERNEL_ARGS} ---
	initrd	/casper/initrd
}
menuentry "Ubuntu Server - manual (interactive) install" {
	set gfxpayload=keep
	linux	/casper/vmlinuz ${FORGE_KERNEL_ARGS} ---
	initrd	/casper/initrd
}
menuentry "Boot from next volume" {
	exit 1
}
if [ "$grub_platform" = "efi" ]; then
	menuentry "UEFI Firmware Settings" {
		fwsetup
	}
fi
